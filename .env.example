# Backend -------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
# Defaults cover the Vite dev server (5173) and preview server (4173).
BOARDING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend ------------------------------------------------------------------
# Leave unset in development: Vite proxies /api to http://127.0.0.1:8000.
# Set it when the built frontend is served from a different origin, e.g.
# VITE_API_BASE=http://localhost:8000
